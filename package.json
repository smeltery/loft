{
  "name": "loft",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "bun@1.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bun test src",
    "lint": "biome lint src scripts vite.config.ts",
    "format": "biome format --write .",
    "format:check": "biome ci --formatter-enabled=true --linter-enabled=false --assist-enabled=false .",
    "typecheck": "tsc --noEmit",
    "check:file-sizes": "bun scripts/check-file-sizes.ts",
    "check:flat-directories": "bun scripts/check-flat-directories.ts",
    "check:markdown": "bun scripts/check-markdown.ts",
    "check:mermaid": "bun scripts/check-mermaid.ts",
    "check:doc-links": "bun scripts/check-doc-links.ts",
    "check:docs": "bun run check:markdown && bun run check:mermaid && bun run check:doc-links",
    "check:budgets": "bun run check:file-sizes && bun run check:flat-directories",
    "check:hygiene": "bun run check:docs && bun run check:budgets",
    "ci": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run check:hygiene"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "linkedom": "^0.18.12",
    "markdownlint": "^0.39.0",
    "mermaid": "^11.12.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
