{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_MARKETING_ONLY", "VITE_API"]
    },
    "test": { "outputs": [] },
    "lint": {},
    "typecheck": { "dependsOn": ["^typecheck"] }
  }
}
