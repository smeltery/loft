#!/bin/sh
# Mirrors .github/workflows/ci.yml before a push.
set -e
cd "$(git rev-parse --show-toplevel)"

echo "▶ pre-push: bun run ci"
bun run ci

if command -v shellcheck >/dev/null 2>&1; then
  echo "▶ pre-push: shellcheck"
  shellcheck .githooks/pre-commit .githooks/pre-push scripts/macos-ci.sh scripts/package-macos.sh
fi

if command -v actionlint >/dev/null 2>&1; then
  echo "▶ pre-push: actionlint"
  actionlint
fi

echo "✓ pre-push checks passed"
