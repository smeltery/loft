#!/bin/sh
# Mirrors CI quality + hygiene. Enable with:
#   git config core.hooksPath .githooks
# Flox activation sets that path automatically.
set -e
cd "$(git rev-parse --show-toplevel)"

if command -v pre-commit >/dev/null 2>&1; then
  exec pre-commit run --all-files --hook-stage pre-commit
fi

echo "pre-commit CLI missing; running bun checks"
bun run format:check
bun run lint
bun run typecheck
bun run test
bun run check:hygiene
